<%- include('../partials/adminTop', { title: 'Invite Candidate', active: 'candidates' }) %>
<%- include('../partials/flash') %>
<div class="page-header">
  <div>
    <h1>Invite Candidate</h1>
    <p class="subtitle">Creates the candidate record and a unique test link for the selected test.</p>
  </div>
  <a class="btn btn-secondary" href="/admin/candidates">&larr; Back</a>
</div>

<div class="card" style="max-width:520px;">
  <% if (tests.length === 0) { %>
    <div class="alert alert-warning">You need to create a Test before inviting candidates.</div>
    <a class="btn" href="/admin/tests/new">+ New Test</a>
  <% } else { %>
  <form method="post" action="/admin/candidates">
    <div class="field">
      <label for="name">Candidate name</label>
      <input type="text" id="name" name="name" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>
    <div class="field">
      <label for="testId">Test</label>
      <select id="testId" name="testId" required>
        <% tests.forEach(function(p) { %>
        <option value="<%= p.id %>"><%= p.title %> (<%= p.totalQuestions %> questions, <%= p.timeLimitMinutes %> min)</option>
        <% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Create invite &amp; generate link</button>
  </form>
  <% } %>
</div>
<%- include('../partials/adminBottom') %>
