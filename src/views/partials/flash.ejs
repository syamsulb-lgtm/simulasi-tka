<% if (typeof flash !== 'undefined' && flash) { %>
  <% (flash.error || []).forEach(function(m) { %><div class="alert alert-error"><%= m %></div><% }) %>
  <% (flash.success || []).forEach(function(m) { %><div class="alert alert-success"><%= m %></div><% }) %>
  <% (flash.info || []).forEach(function(m) { %><div class="alert alert-info"><%= m %></div><% }) %>
  <% (flash.warning || []).forEach(function(m) { %><div class="alert alert-warning"><%= m %></div><% }) %>
<% } %>
